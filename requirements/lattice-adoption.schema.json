{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fogofsea.app/schemas/lattice-adoption.schema.json",
  "title": "FOG OF SEA bounded Lattice adoption requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registerId",
    "version",
    "scope",
    "provenance",
    "requirements"
  ],
  "properties": {
    "format": {
      "const": "fog-of-sea-lattice-adoption-requirements-v1"
    },
    "registerId": {
      "const": "FOS-LAT"
    },
    "version": {
      "const": "1.0.0"
    },
    "scope": {
      "$ref": "#/definitions/scope"
    },
    "provenance": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/provenance"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/requirement"
      }
    }
  },
  "definitions": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "excluded",
        "broadAdoptionStatus",
        "statement"
      ],
      "properties": {
        "authorized": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "broadAdoptionStatus": {
          "const": "blocked"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "revision",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PROV-[0-9]{3}$"
        },
        "kind": {
          "enum": [
            "user-directive",
            "repository",
            "profile",
            "implementation-audit",
            "project-policy"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assertion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}-AC-[0-9]{2}$"
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "assertion",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}-T-[PNB][0-9]{2}$"
        },
        "kind": {
          "enum": [
            "positive",
            "negative",
            "boundary"
          ]
        },
        "assertion": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supersession": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supersededBy",
            "reason"
          ],
          "properties": {
            "supersededBy": {
              "type": "string",
              "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "provenanceIds",
        "priority",
        "precedence",
        "dependencies",
        "conflicts",
        "owners",
        "acceptanceCriteria",
        "tests",
        "evidenceMethods",
        "status",
        "supersedes",
        "supersession"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "provenanceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PROV-[0-9]{3}$"
          }
        },
        "priority": {
          "enum": [
            "mandatory",
            "high",
            "advisory"
          ]
        },
        "precedence": {
          "type": "integer",
          "minimum": 1
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}$"
          }
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/criterion"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/test"
          },
          "allOf": [
            {"contains": {"type": "object", "properties": {"kind": {"const": "positive"}}, "required": ["kind"]}},
            {"contains": {"type": "object", "properties": {"kind": {"const": "negative"}}, "required": ["kind"]}},
            {"contains": {"type": "object", "properties": {"kind": {"const": "boundary"}}, "required": ["kind"]}}
          ]
        },
        "evidenceMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "schema-validation",
              "static-analysis",
              "unit-test",
              "red-team-mutation",
              "build-artifact-inspection",
              "manual-review-not-claimed",
              "browser-inventory-only"
            ]
          }
        },
        "status": {
          "enum": [
            "planned",
            "implemented",
            "verified",
            "blocked",
            "exempt",
            "superseded"
          ]
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}$"
          }
        },
        "supersession": {
          "$ref": "#/definitions/supersession"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "superseded"}}},
          "then": {
            "properties": {
              "supersession": {"type": "object"}
            }
          },
          "else": {
            "properties": {
              "supersession": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
