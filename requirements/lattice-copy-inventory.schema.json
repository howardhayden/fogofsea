{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fogofsea.app/schemas/lattice-copy-inventory.schema.json",
  "title": "FOG OF SEA bounded Lattice copy inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "scope", "units"],
  "properties": {
    "format": {"const": "fog-of-sea-lattice-copy-inventory-v1"},
    "version": {"const": "1.0.0"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitCount", "requestCount", "outputCount", "sourceSymbolCount", "academyLintMode", "broadAdoptionStatus", "statement"],
      "properties": {
        "unitCount": {"const": 37},
        "requestCount": {"const": 19},
        "outputCount": {"const": 26},
        "sourceSymbolCount": {"const": 12},
        "academyLintMode": {"const": "advisory-curriculum-data"},
        "broadAdoptionStatus": {"const": "blocked"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "units": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {"$ref": "#/definitions/unit"}
    }
  },
  "definitions": {
    "requestId": {
      "enum": [
        "fos.academy.compare-intro",
        "fos.academy.independent-status",
        "fos.academy.language-system",
        "fos.academy.model-boundary",
        "fos.academy.sources-intro",
        "fos.game.guide.command-turns",
        "fos.game.guide.mission-credit",
        "fos.game.guide.mission-learning",
        "fos.game.guide.model-boundary",
        "fos.game.guide.scenario-acceptance",
        "fos.game.guide.strategic-fit",
        "fos.game.guide.uncrewed-undersea",
        "fos.game.learning.outcome-adjustment",
        "fos.game.learning.outcome-clear",
        "fos.game.learning.outcome-pending",
        "fos.game.learning.outcome-uncertainty",
        "fos.game.learning.turn-clear",
        "fos.game.learning.turn-uncertainty",
        "fos.game.outcome.unscored-writing"
      ]
    },
    "outputTarget": {
      "enum": [
        "academy.compare.intro",
        "academy.sources.independentStatus",
        "academy.sources.intro",
        "academy.sources.languageSystem",
        "academy.sources.modelBoundary",
        "game.guide.commandTurns.interpretive",
        "game.guide.commandTurns.operative",
        "game.guide.missionCredit.interpretive",
        "game.guide.missionCredit.operative",
        "game.guide.missionLearning.interpretive",
        "game.guide.missionLearning.operative",
        "game.guide.modelBoundary.interpretive",
        "game.guide.modelBoundary.operative",
        "game.guide.scenarioAcceptance.interpretive",
        "game.guide.scenarioAcceptance.operative",
        "game.guide.strategicFit.interpretive",
        "game.guide.strategicFit.operative",
        "game.guide.uncrewedUndersea.interpretive",
        "game.guide.uncrewedUndersea.operative",
        "game.learning.outcome.adjustment",
        "game.learning.outcome.clear",
        "game.learning.outcome.pending",
        "game.learning.outcome.uncertainty",
        "game.learning.turn.clear",
        "game.learning.turn.uncertainty",
        "game.outcome.unscoredWriting"
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "surface", "mode", "stakes", "representation"],
      "properties": {
        "layer": {"enum": ["operative", "experiential", "interpretive"]},
        "surface": {"enum": ["instruction", "prompt", "transition", "reflection", "summary", "report", "tooltip", "tutorial", "after-action", "public-notice", "narration"]},
        "mode": {"enum": ["briefing", "consequence", "environment", "analysis", "action", "exposition", "aftermath", "technical", "institutional", "reflection"]},
        "stakes": {"enum": ["ambient", "consequential", "urgent", "safety-critical"]},
        "representation": {"enum": ["standard", "accessibility-equivalent", "both"]}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?:app|public|docs|scripts|requirements)/[^\\\\]+$"},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "surfaceName", "description", "status", "exemptionReason", "route", "targetAssurance", "owners", "requestIds", "outputTargets", "requirementIds", "risks", "supersedes"],
      "properties": {
        "id": {"type": "string", "pattern": "^FOS-COPY-[A-Z]+-[0-9]{3}$"},
        "family": {"enum": ["debrief", "field-guide", "academy", "shell", "privacy", "scenario", "planning", "force", "command", "contact", "accessibility", "save", "error"]},
        "surfaceName": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["adopted", "advisory", "exempt", "blocked", "out-of-scope"]},
        "exemptionReason": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "route": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/route"}]},
        "targetAssurance": {
          "description": "Review target for an adopted unit; it is not an emitted Lattice conformance claim.",
          "enum": ["strong", "advisory", "controlled-literal", "not-applicable"]
        },
        "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/owner"}},
        "requestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/requestId"}},
        "outputTargets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/outputTarget"}},
        "requirementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FOS-LAT-[A-Z]+-[0-9]{3}$"}},
        "risks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FOS-COPY-[A-Z]+-[0-9]{3}$"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "adopted"}}},
          "then": {
            "properties": {
              "exemptionReason": {"type": "null"},
              "route": {"$ref": "#/definitions/route"},
              "targetAssurance": {"enum": ["strong", "advisory", "controlled-literal"]},
              "requestIds": {"minItems": 1},
              "outputTargets": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "exemptionReason": {"type": "string", "minLength": 1},
              "route": {"type": "null"},
              "targetAssurance": {"const": "not-applicable"},
              "requestIds": {"maxItems": 0},
              "outputTargets": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
