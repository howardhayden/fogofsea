{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fogofsea.app/schemas/lattice-copy-index.schema.json",
  "title": "FOG OF SEA Lattice copy evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "current", "entries"],
  "properties": {
    "schemaVersion": { "const": "fog-of-sea.lattice-copy.index.v2" },
    "current": { "$ref": "#/$defs/current" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementationAuthorityFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "package-lock.json",
            "package.json",
            "requirements/lattice-adoption.schema.json",
            "requirements/lattice-copy-inventory.schema.json",
            "schemas/lattice-copy-evidence.schema.json",
            "schemas/lattice-copy-generated.schema.json",
            "schemas/lattice-copy-index.schema.json",
            "schemas/lattice-copy-requests.schema.json",
            "schemas/lattice-copy-runtime.schema.json",
            "scripts/compile-lattice-copy.mjs",
            "scripts/lattice-copy-corpus.mjs",
            "scripts/validate-lattice-schemas.d.mts",
            "scripts/validate-lattice-schemas.mjs",
            "scripts/verify-lattice-copy.mts"
          ]
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "implementationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm", "files", "sha256"],
      "properties": {
        "format": { "const": "fog-of-sea.lattice-implementation-authority.v1" },
        "algorithm": { "const": "sha256-stable-json-v1" },
        "files": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/implementationAuthorityFile" }
        },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^lattice-copy-[a-f0-9]{24}$"
    },
    "conformance": {
      "enum": ["literal", "degraded"]
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "path", "sha256"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "path": { "const": "evidence/lattice/current.json" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "evidencePath",
        "evidenceSha256",
        "generatedPath",
        "generatedSha256",
        "runtimePath",
        "runtimeSha256",
        "requestSha256",
        "academySourceSha256",
        "academyCorpusSha256",
        "academyLintSha256",
        "traceabilitySha256",
        "realizationSha256",
        "copySha256",
        "conformance",
        "humanReviewStatus",
        "engineVersion",
        "profileVersion",
        "profileDigest",
        "implementationAuthority"
      ],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "evidencePath": { "const": "evidence/lattice/current.json" },
        "evidenceSha256": { "$ref": "#/$defs/digest" },
        "generatedPath": { "const": "app/generated/lattice-copy.json" },
        "generatedSha256": { "$ref": "#/$defs/digest" },
        "runtimePath": { "const": "app/generated/lattice-copy.runtime.json" },
        "runtimeSha256": { "$ref": "#/$defs/digest" },
        "requestSha256": { "$ref": "#/$defs/digest" },
        "academySourceSha256": { "$ref": "#/$defs/digest" },
        "academyCorpusSha256": { "$ref": "#/$defs/digest" },
        "academyLintSha256": { "$ref": "#/$defs/digest" },
        "traceabilitySha256": { "$ref": "#/$defs/digest" },
        "realizationSha256": { "$ref": "#/$defs/digest" },
        "copySha256": { "$ref": "#/$defs/digest" },
        "conformance": { "$ref": "#/$defs/conformance" },
        "humanReviewStatus": { "const": "not-claimed" },
        "engineVersion": { "const": "0.1.1" },
        "profileVersion": { "const": "v1.0.0" },
        "profileDigest": { "const": "379ed01484574edc779efdc502ffbd6d9b8ffef3c9154fb027b0f0c8475ed21a" },
        "implementationAuthority": { "$ref": "#/$defs/implementationAuthority" }
      }
    }
  }
}
